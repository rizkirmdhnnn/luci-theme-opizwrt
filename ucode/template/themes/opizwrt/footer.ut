{% if (!blank_page): %}
			</div>
			<footer class="mobile-hide">
				<span>{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</span>
				<span class="footer-sep">·</span>
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} {{ version.luciversion }}</a>
				<span class="footer-sep">·</span>
				<a class="footer-mark" href="https://github.com/rizkirmdhnnn/luci-theme-opizwrt" target="_blank" rel="noreferrer">Opizwrt theme <b>by Rizpedia</b></a>
			</footer>
		</div>
	</div>
</div>

<script>L.require('menu-opizwrt')</script>
{% else %}
	</div>
	<p class="login-foot">{{ version.distname }} {{ version.distversion }}</p>
</div>
{% endif %}

</body>
</html>
